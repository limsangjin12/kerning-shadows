{
  "name": "maple-like-game-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "assets:audio": "node scripts/generate-audio-assets.mjs",
    "assets:webp": "node scripts/generate-runtime-webp.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-release-notices.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "audit:dist": "node scripts/audit-dist.mjs",
    "release:check": "npm test && npm run test:e2e && npm run audit:dist"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
